{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "darchi",
  "outputfilename": "Darchi",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "xajiraqab",
    "email": "btutberidze@daxi.ge"
  },
  "postBuildHooks": {
    "windows/*": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$bin = [System.IO.Path]::GetFullPath('${bin}'); $root = Split-Path (Split-Path (Split-Path $bin)); & (Join-Path $root 'scripts/pack-windows.ps1') -Binary $bin\""
  }
}
