{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "darchi",
  "outputfilename": "darchi",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "xajiraqab",
    "email": "btutberidze@daxi.ge"
  },
  "postBuildHooks": {
    "windows/*": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-windows.ps1 -Binary \"${bin}\""
  }
}
